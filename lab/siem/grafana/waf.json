{
  "uid": "waf",
  "title": "WAF - ModSecurity + CRS",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Yêu cầu bị chặn (403) theo thời gian",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"waf\"} |= \"ModSecurity: Access denied\" [1m]))",
          "legendFormat": "bị chặn / phút"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Luật CRS khớp nhiều nhất",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(10, sum by (rule) (count_over_time({service=\"waf\"} |= \"ModSecurity: \" | pattern `<_>[id \"<rule>\"]<_>` [$__range])))",
          "legendFormat": "{{rule}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [],
          "fields": "/^Value/",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "min": 0
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "type": "logs",
      "title": "Log WAF: IP nguồn, luật, hành động, URI, thông điệp",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"waf\"} |= \"ModSecurity: \" | regexp `ModSecurity: (?P<action>Warning|Access denied with code \\d+).*\\[id \"(?P<rule>\\d+)\"\\].*\\[msg \"(?P<msg>[^\"]*)\"\\].*\\[uri \"(?P<uri>[^\"]*)\"\\].*client: (?P<ip>[^,]+)` | line_format `{{.ip}}  {{.rule}}  {{.action}}  {{.uri}}  {{.msg}}`"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
